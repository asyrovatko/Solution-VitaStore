                ContainerDb(posboDB, "Хранилище облачного бэк-офиса кассы", "TO2 [NEW] | SaaS | МойСклад DB", "Справочник и цены касс, журнал чеков; вебхуки о продажах. Источник данных BI")
                Container(loy, "Программа лояльности", "TO3 [NEW] | SaaS | МойСклад - расширенная бонусная программа", "Карты/телефоны покупателей, баллы, правила начисления и списания")
                Container(bot, "Чат-бот SKU Matching", "TO4 [NEW] | SaaS | Битрикс24 (чат-бот, REST API)", "Ставит продавцу вопрос по неизвестной позиции, собирает штрихкод и фото")
                Container(tasks, "Задачи и CRM", "TO5 [NEW] | SaaS | Битрикс24 (Задачи, CRM)", "Эскалации товароведу, выезды ИТ, маркетинг")
                Container(mdm, "Консоль управления устройствами (MDM)", "TO6 [NEW] | SaaS | Kaspersky Endpoint Security Cloud", "Регистрация планшетов, политики, установка приложений")
                Container(bi, "BI-отчётность", "TO7 [NEW] | SaaS | Yandex DataLens", "Продажи, остатки, ТСО по магазинам")
          }
          System_Boundary(hq_paas, "Класс: PaaS") {
                Container(gw, "API Gateway", "T08 [NEW] | PaaS | Yandex API Gateway", "Единая точка входа для вебхуков МойСклад, Битрикс24, загрузки дампов")
                Container(ingest, "Приём дампов", "TO9 [NEW] | PaaS | Yandex Object Storage", "Приём и хранение дампов магазинов (CSV/XLSX) по pre-signed ссылке")
                Container(sku, "SKU Matching (ИИ)", "TO10 [NEW] | PaaS | YandexGPT API", "Сопоставление товаров и эскалации")
                Container(integ, "Интеграционные функции", "TO11 [NEW] | PaaS | Yandex Cloud Functions", "Коннекторы: МойСклад, Data Streams, проверка дампов")
                Container(bus, "Шина событий", "TO12 [NEW] | PaaS | Yandex Data Streams (Kafka API 3.4)", "Бизнес-события")
                ContainerDb(db, "Операционная БД интеграций", "TO13 [NEW] | PaaS | Yandex Managed Service for YDB (Serverless)", "Результаты сопоставления, журнал интеграций")
          }
          System_Boundary(hq_onprem, "Класс: On-premise (сохраняется)") {
               Container(erp, "SAP ERP", "AS10 [CHANGED] on-premises", "Главная центральная система учета (Товары, цены, лояльность) (+взаимодействия с шиной)")
               Container(promo, "Promo Engine", "AS11 [CHANGED] on-premises", "Промо (+взаимодействия с шиной)")
               Container(sf, "Smart Fulfillment ", "AS12 [CHANGED] on-premises", "Товародвижение, онлайн-заказы (+взаимодействия с шиной)")
               Container(pgo, "Payment Gateway Онлайн", "AS13 [CHANGED] on-premises", "Абстрактный слой платежей онлайн")
          }
