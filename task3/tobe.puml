                ContainerDb(excel, "Excel файл", "AS7 [RETAINED] файл Excel", "Файл c базой магазина")
                ContainerDb(ldb, "Автономное хранилище кассы", "TO17 [NEW] | встроенное хранилище | автономный режим Кассы МойСклад", "Используется только без связи: справочник на момент последней синхронизации и очередь неотправленных продаж")
