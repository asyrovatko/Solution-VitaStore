          }
          System_Boundary(st_hw, "Класс: оборудование") {
                Container_Ext(term, "Банковский терминал", "TO19 [CHANGED] | оборудование | терминал эквайринга Сбербанка (INPAS, TCP/IP по Wi-Fi)", "Приём карт; сумма приходит из Кассы МойСклад")
