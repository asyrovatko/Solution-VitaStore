@startuml VitaStore_C4_TOBE
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

AddRelTag("business", $lineColor="orchid", $textColor = "orchid" )
AddRelTag("sale", $lineColor="green", $textColor = "green" )
AddRelTag("periph", $lineColor="olive", $textColor = "olive" )
AddRelTag("payment", $lineColor="turquoise", $textColor = "turquoise" )
AddRelTag("its", $lineColor="blue", $textColor = "blue" )
AddRelTag("offline", $lineColor="red", $textColor = "red" )
AddRelTag("sku", $lineColor="orange", $textColor = "orange" )
AddRelTag("manual", $lineColor="brown", $textColor = "brown" )
AddRelTag("tax", $lineColor="black", $textColor = "black" )
AddRelTag("multy", $lineColor="purple", $textColor = "purple" )

title VitaStore — C4 Container TO-BE
Boundary(sale, "Sale") {
Person(seller, "Продавец", "A1 [RETAINED] Роль |  Работает с кассой и оборудованием в магазине")
Person_Ext(client, "Покупатель", "A2 [RETAINED] Роль | Покупает в магазине и онлайн")
}
Boundary(commdep, "Коммерческий департамент") {
Person(merch, "Товаровед (Team Data Integration)", "A3 [RETAINED] Роль | Сопоставление номенклатуры магазинов при миграции")
Person(comm, "Коммерческий департамент", "A5 [RETAINED] Роль | Ассортимент, цены, акции, поставщики")
}
Person(its, "ИТ-специалист (Team Store Ops)/Департамент ИТ", "A4 [RETAINED] Роль | Подключение магазина")
Person(ma, "Департамент развития", "A6 [RETAINED] Роль | Покупает магазины")

